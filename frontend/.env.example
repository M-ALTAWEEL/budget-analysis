# Copy to .env.local.
# The browser calls the API through this site (/api/v1 is proxied by next.config.ts),
# so you normally do not need to change this.
NEXT_PUBLIC_API_URL=/api/v1
# Where Next.js forwards /api/v1/* (the FastAPI server).
API_ORIGIN=http://localhost:8000
# Shared secret with the API (EDGE_SECRET in backend/.env). Sent only server-to-server,
# never to the browser. Optional locally.
# EDGE_SECRET=
