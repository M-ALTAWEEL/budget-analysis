# Copy this file to .env and fill in the values. Never commit .env.

APP_ENV=development

# Local run (uvicorn on your machine). Inside Docker Compose this is overridden
# to point at the "db" service automatically.
DATABASE_URL=postgresql+asyncpg://budgetbuddy:budgetbuddy@localhost:5432/budgetbuddy

# Comma-separated origins allowed to call the API from a browser.
FRONTEND_URL=http://localhost:3000

# JWT signing key (at least 32 characters). Optional in development: a built-in
# dev key is used when this is not set. REQUIRED in production. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# SECRET_KEY=
