# Copy this file to .env and fill in the values. Never commit .env.

APP_ENV=development

# Local run (uvicorn on your machine). Inside Docker Compose this is overridden
# to point at the "db" service automatically.
DATABASE_URL=postgresql+asyncpg://budgetbuddy:budgetbuddy@localhost:5432/budgetbuddy

# Comma-separated origins allowed to call the API from a browser.
FRONTEND_URL=http://localhost:3000

# JWT signing key (at least 32 characters). Optional in development: a built-in
# dev key is used when this is not set. REQUIRED in production. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# SECRET_KEY=

# Where this server runs: local, staging or production (names the place in logs and
# error reports).
# DEPLOY_ENV=local

# Error reports (optional). The DSN from sentry.io > Project > Client Keys.
# SENTRY_DSN=

# Redis for shared rate-limit counters (optional locally; Docker Compose sets it).
# REDIS_URL=redis://localhost:6379/0

# "Sign in with Google" (optional). The OAuth client ID from Google Cloud Console
# (APIs & Services > Credentials). Empty = the Google button is hidden.
# GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com
